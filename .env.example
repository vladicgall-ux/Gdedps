# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxx
SUPABASE_SERVICE_ROLE_KEY=xxxxx

# --- App session ---
# Random 32+ char secret used to sign session JWTs (openssl rand -hex 32)
SESSION_SECRET=change-me-please-32-bytes-minimum

# --- Telegram ---
# Bot created via @BotFather, used for both the Login Widget and the Mini App
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=GdeDpsBot
# Secret Telegram sends back on every webhook call (see app/api/telegram/webhook),
# checked against the X-Telegram-Bot-Api-Secret-Token header (openssl rand -hex 24)
TELEGRAM_WEBHOOK_SECRET=change-me-too

# --- App ---
# Public URL of this deployment, used to build the Mini App launch button
APP_URL=https://your-deployment.vercel.app

# --- VK ---
# VK ID / Mini App credentials from https://id.vk.com/business and vk.com/apps?act=manage
NEXT_PUBLIC_VK_APP_ID=51000000
VK_APP_SECRET=xxxxx
VK_SERVICE_TOKEN=xxxxx

# --- MAX ---
# Fill in once MAX publishes their production OAuth / mini-app credentials.
NEXT_PUBLIC_MAX_APP_ID=xxxxx
MAX_APP_SECRET=xxxxx
MAX_AUTH_URL=https://oauth.max.ru/authorize
MAX_TOKEN_URL=https://oauth.max.ru/token

# --- Cron ---
# Protects /api/cron/cleanup, set the same value in Vercel Project Settings -> Cron
CRON_SECRET=change-me-too
